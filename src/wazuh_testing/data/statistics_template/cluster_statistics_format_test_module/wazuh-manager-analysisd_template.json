{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "affected_items": {
            "type": "array",
            "items": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^wazuh-manager-analysisd$"
                  },
                  "uptime": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "global": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "enabled": {
                          "type": "boolean"
                        },
                        "value": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "name",
                        "type",
                        "enabled",
                        "value"
                      ]
                    }
                  },
                  "spaces": {
                    "type": "array"
                  }
                },
                "required": [
                  "name",
                  "uptime",
                  "timestamp",
                  "global",
                  "spaces"
                ]
              }
            ]
          },
          "total_affected_items": {
            "type": "integer"
          },
          "total_failed_items": {
            "type": "integer"
          },
          "failed_items": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "affected_items",
          "total_affected_items",
          "total_failed_items",
          "failed_items"
        ]
      },
      "message": {
        "type": "string"
      },
      "error": {
        "type": "integer"
      }
    },
    "required": [
      "data",
      "message",
      "error"
    ]
  }
